# ============================================
# Environment Variables for MyCloudStorage
# ============================================
# Copy this file to .env and fill in real values.
# For local development (dotnet run): use JWT_KEY directly.
# For Docker (docker-compose up): JWT_SECRET is mapped to JWT_KEY.
# ============================================

# --- JWT / Authentication ---
# Local dev: set JWT_KEY directly
# Docker: set JWT_SECRET (docker-compose maps it to JWT_KEY)
JWT_KEY="change_me_to_a_long_random_string"
JWT_SECRET="change_me_to_a_long_random_string"

JWT_ISSUER="https://yourdomain.com"
JWT_AUDIENCE="https://yourdomain.com
# --- Database ---
# Used by Program.cs to build the connection string from appsettings.json
# appsettings.json template: "...Password=%DB_PASSWORD%"
DB_PASSWORD="your_postgres_password_here"

# --- Email / SMTP (for password reset, email verification) ---
SMTP_HOST="smtp.example.com"
SMTP_USERNAME="your_smtp_username@example.com"
SMTP_KEY="your_smtp_password_or_api_key"

# --- Server Configuration (optional, used by docker-compose) ---
# JWT_ISSUER and JWT_AUDIENCE are also set in docker-compose.yml directly
# If deploying with docker-compose you can override them there.
